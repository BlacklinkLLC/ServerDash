{
  "id": "uptime-monitor",
  "name": "Uptime monitor",
  "version": "1.0.0",
  "description": "Checks that your websites and APIs respond, and how fast.",
  "author": "Blacklink",
  "icon": "Activity",
  "requires": ["curl"],
  "settings": [
    { "key": "urls", "label": "URLs", "type": "textarea", "default": "https://nova.blacklink.net", "placeholder": "https://example.com\nhttp://192.168.1.10:8123", "help": "One per line." },
    { "key": "slow_ms", "label": "Mark as slow above (ms)", "type": "number", "default": "1500" }
  ],
  "widgets": [
    { "id": "status", "title": "Sites", "format": "table", "command": "sh ./check.sh", "interval": 60, "wide": true }
  ]
}
