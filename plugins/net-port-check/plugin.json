{
  "id": "net-port-check",
  "name": "Port Open",
  "version": "1.0.0",
  "description": "TCP probe result",
  "author": "Blacklink",
  "icon": "Connect",
  "widgets": [
    {
      "id": "main",
      "title": "Port Open",
      "format": "stats",
      "command": "sh ./main.sh",
      "interval": 300,
      "wide": false
    }
  ],
  "requires": [
    "nc"
  ],
  "settings": [
    {
      "key": "host",
      "label": "Host",
      "type": "text",
      "default": "example.com",
      "help": "Hostname or IP address"
    },
    {
      "key": "port",
      "label": "Port",
      "type": "text",
      "default": "443",
      "help": "TCP port"
    }
  ]
}
