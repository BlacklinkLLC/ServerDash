# Copy to .env and adjust as needed. docker compose reads this file
# automatically for the ${VAR} substitutions in docker-compose.yml.

# Host port the dashboard UI is published on.
SERVERDASH_PORT=9900

# Hostname the dashboard is reverse-proxied at; used for CORS allow-listing.
SERVERDASH_PUBLIC_HOST=nova.blacklink.net

# Docker Engine API socket. Podman's socket is API-compatible — point this
# at it instead (e.g. unix:///run/user/1000/podman/podman.sock) and update
# the matching volume mount in docker-compose.yml.
SERVERDASH_DOCKER_HOST=unix:///var/run/docker.sock

# Path to a kubeconfig, only needed if you've uncommented the kubeconfig
# mount in docker-compose.yml. Leave unset and ServerDash just reports
# Kubernetes as unavailable.
SERVERDASH_KUBECONFIG=

# Command a workflow's "Rebuild & Run" block runs. Change to "podman-compose"
# if that's what's installed instead of the Docker Compose plugin.
SERVERDASH_COMPOSE_CMD=docker compose
